# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# --- LLM (OpenAI-compatible endpoint) ---
# Default: Gemini free tier via Google AI Studio
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=

# Optional fallback LLM provider
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- Database ---
DB_PATH=

# --- Shop owner (Phase 2) ---
# Telegram user ID of the shop owner (get it via @userinfobot)
OWNER_TELEGRAM_ID=
# Alert the owner when stock drops to this level or below
LOW_STOCK_THRESHOLD=

# --- Web dashboard (Phase 3) ---
DASHBOARD_PASSWORD=
SECRET_KEY=

# --- WhatsApp Cloud API (Phase 4) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=

# --- Payments ---
# Optional path to a UPI QR image; /setqr upload in Telegram takes priority
UPI_QR_PATH=

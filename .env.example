# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# LLM Configuration (OpenAI-compatible endpoint)
# Default: Gemini free tier via Google AI Studio
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=8.0
LLM_MAX_RETRIES=2

# Optional Fallback LLM provider (Phase 5 reliability)
# LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=gemini-3.8-flash

# Database path
DB_PATH=data/sollunga.db

# Owner Configuration (Phase 2)
# Telegram user ID of shop owner (get via @userinfobot)
OWNER_TELEGRAM_ID=
# Alert owner when item stock drops to this level or below
LOW_STOCK_THRESHOLD=3

# Web Dashboard Configuration (Phase 3)
DASHBOARD_PASSWORD=sollunga123
SECRET_KEY=sollunga-secret-session-key-change-in-prod

# WhatsApp Cloud API Configuration (Phase 4)
# Free test number from Meta Developer Console (WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=sollunga_verify_token
WHATSAPP_API_VERSION=v21.0


